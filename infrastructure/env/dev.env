DEV=true
GIT_COMMIT=${GIT_COMMIT}

### server configurations

ENABLE_DEFAULT_USER=true
DEFAULT_USER_NAME=admin
DEFAULT_USER_PASSWORD=admin

JWT_SECRET=2FDAB8480FEDB4B6FEC812D8F697EBB4D1ED9C14DC3E0A5C2467EDC64D3E024E
JWT_ACCESS_TOKEN_LIFETIME=60 # minutes
JWT_SESSION_TOKEN_LIFETIME=30 # days, change this in the database too (see close_abandoned_sessions)

MAX_OPEN_SESSIONS=5
MAX_LOGIN_ATTEMPTS=5 # per MAX_LOGIN_ATTEMPTS_TIME minutes
LOGIN_ATTEMPT_TIMESPAN=10 # minutes
LOGIN_RESTRICTION_TIME=15 # minutes

### other container configurations

# autoheal
AUTOHEAL_CONTAINER_LABEL=all
AUTOHEAL_INTERVAL=5
AUTOHEAL_START_PERIOD=120
AUTOHEAL_DEFAULT_STOP_TIMEOUT=30

# grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=password

# postgres
DATABASE_POOL_SIZE=100
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=root # only this has to be changed in pgweb and grafana data sources too
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# minio
MINIO_URL=http://minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_PROMETHEUS_AUTH_TYPE="public"
WALG_COMPRESSION_METHOD=lz4

# redis
REDIS_URL=redis://redis:6379/0

# postgres backups
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=${POSTGRES_DB}
WALE_S3_PREFIX=s3://pg-backups
AWS_ENDPOINT=${MINIO_URL}
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_S3_FORCE_PATH_STYLE=true
