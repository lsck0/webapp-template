### Get current session (requires auth)

GET https://127.0.0.1/api/session?tag=Current HTTP/1.1
Authorization: Bearer <access_token>

### Get all sessions (requires auth)

GET https://127.0.0.1/api/session?tag=All HTTP/1.1
Authorization: Bearer <access_token>

### Get valid sessions (requires auth)

GET https://127.0.0.1/api/session?tag=Valid HTTP/1.1
Authorization: Bearer <access_token>

### Close a session by ID (requires auth)

PUT https://127.0.0.1/api/session HTTP/1.1
Content-Type: application/json
Authorization: Bearer <access_token>

{
  "id": "<session_id>"
}

### Close all sessions (requires auth)

PUT https://127.0.0.1/api/session HTTP/1.1
Content-Type: application/json
Authorization: Bearer <access_token>

{}

### Delete a session by ID (requires auth)

DELETE https://127.0.0.1/api/session?id=<session_id> HTTP/1.1
Authorization: Bearer <access_token>

### Delete all sessions (requires auth)

DELETE https://127.0.0.1/api/session HTTP/1.1
Authorization: Bearer <access_token>
