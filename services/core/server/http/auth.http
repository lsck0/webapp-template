### Login (admin)

POST https://127.0.0.1/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "name": "admin",
  "password": "admin",
  "otp": null
}

### Register a new user (requires invite token)

POST https://127.0.0.1/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "name": "alice",
  "password": "alice_password_123",
  "invite": "<invite_token>"
}

### Get invite token (requires auth)

GET https://127.0.0.1/api/auth/invite HTTP/1.1
Authorization: Bearer <access_token>

### Refresh session

POST https://127.0.0.1/api/auth/refresh HTTP/1.1
Content-Type: application/json

{
  "session_id": "<session_id>",
  "session_token": "<session_token>"
}

### Logout (requires auth)

POST https://127.0.0.1/api/auth/logout HTTP/1.1
Authorization: Bearer <access_token>

### Change password (requires auth)

POST https://127.0.0.1/api/auth/password-change HTTP/1.1
Content-Type: application/json
Authorization: Bearer <access_token>

{
  "old_password": "admin",
  "new_password": "new_password_123",
  "otp": null
}
